{
  "name": "metaservice-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc --noEmit && tsc -p e2e --noEmit",
    "check": "bun scripts/check-safe-markup.ts && bun run typecheck",
    "test": "bun test",
    "e2e": "bun e2e/panel.e2e.ts && bun e2e/connect.e2e.ts && bun e2e/machine-page.e2e.ts && bun e2e/chat.e2e.ts && bun e2e/terminal.e2e.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "puppeteer-core": "^25.13.0",
    "svelte": "^5.19.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  }
}
