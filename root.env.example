# Copy to ~/.metaservice/root.env on the Root machine, fill in, and make it owner-only: mode 600.
# The Root refuses to start if this file is readable by anyone else. Never commit the real file.

# Sign-in (Google) and who may use the panel (comma separated)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAILS=

# AI provider for the chat. Set all three or none. https, or http to a private address (a local model server).
AI_BASE_URL=
AI_API_KEY=
AI_DEFAULT_MODEL=
# Optional: most tokens in one reply (1 to 4096, default 512) and how long a chat's pass lasts in seconds (60 to 3600, default 600)
AI_MAX_TOKENS=
AI_CAPABILITY_SECONDS=

# Scan (optional). A private network no wider than /22, and a read-only MikroTik account.
SCAN_SUBNET=
ROUTER_URL=
ROUTER_USER=
ROUTER_PASSWORD=
