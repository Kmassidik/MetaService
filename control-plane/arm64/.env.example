# MetaService settings. Copy to control-plane/arm64/.env, owner-only (chmod 600). Never commit the real file.
# Nothing is required: with every line empty it runs on this Mac only. Blank means "not set".

# Chat AI (all three, or none). Address is https, or http to a private address. The key never leaves this file.
AI_BASE_URL=
AI_API_KEY=
AI_DEFAULT_MODEL=

# Open the panel from outside (all four, or none). Public address with no port or path, e.g. https://meta.example.com.
# The token needs Zone DNS: Edit and Account Cloudflare Tunnel: Edit. `./install.sh remote up` uses them.
PUBLIC_BASE_URL=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# Optional, add only if needed (the first-run ROOT_SETUP_TOKEN is made for you):
#   ROOT_AGENT_BIND, ROOT_AGENT_PORT    this Mac's LAN address, so Agents on other machines can enroll
#   AI_MAX_TOKENS, AI_CAPABILITY_SECONDS  AI limits
#   SCAN_SUBNET                         only if the automatic network scan picks the wrong network
#   ROUTER_URL, ROUTER_USER, ROUTER_PASSWORD  read-only MikroTik account (Omada is not supported)
